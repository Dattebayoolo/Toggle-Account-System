PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toggle_auth
JWT_ISSUER=https://auth.toggle.local
JWT_KEY_ID=toggle-key-1
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PUBLIC_KEY\n-----END PUBLIC KEY-----"
AUTH_BASE_URL=http://localhost:4000
TOGGLE_DOCS_PORT=4100
TOGGLE_DOCS_BASE_URL=http://localhost:4100
TOGGLE_CALENDAR_PORT=4200
TOGGLE_CALENDAR_BASE_URL=http://localhost:4200
SSO_SESSION_COOKIE_NAME=toggle_sso_session

# Refresh-token rotation (offline_access)
REFRESH_TOKEN_TTL_DAYS=30

# Optional: previous public keys for JWKS rotation, as a JSON array
# [{"kid":"toggle-key-0","pem":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}]
JWT_PREVIOUS_PUBLIC_KEYS=[]

# Optional SMTP for real verification/reset emails (dev links are used when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Toggle Account <no-reply@toggle.local>
